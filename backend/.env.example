# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# PostgreSQL connection URL
# Format: postgresql+psycopg://user:password@host:port/dbname
DATABASE_URL=postgresql+psycopg://postgres:password@localhost:5432/worknoon_refund

# Application settings
APP_ENV=development
APP_DEBUG=false

# AI / LLM settings
# AI_API_KEY: your Google Gemini API key (required when using the AI analysis endpoint)
#             Obtain from https://aistudio.google.com/app/apikey
AI_API_KEY=
# AI_MODEL: the Gemini model to use for refund analysis (default: gemini-2.0-flash)
AI_MODEL=gemini-2.0-flash
