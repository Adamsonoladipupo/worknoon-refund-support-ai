# ─────────────────────────────────────────────────────────────────────────────
# Worknoon Refund System — Root .env.example
#
# Copy this file to .env and fill in your real values.
# NEVER commit .env to version control — it is in .gitignore.
#
# This file is read by docker-compose.  The backend/.env is used for local
# (non-Docker) development only.
# ─────────────────────────────────────────────────────────────────────────────

# ── PostgreSQL ────────────────────────────────────────────────────────────────
# Password used by both the postgres container and the backend DATABASE_URL.
POSTGRES_PASSWORD=worknoon_dev_password

# ── Backend ───────────────────────────────────────────────────────────────────
APP_ENV=development
APP_DEBUG=false

# ── AI / Google Gemini ────────────────────────────────────────────────────────
# Required for the AI-assisted refund endpoint (POST /api/refunds/ai).
# Obtain from: https://aistudio.google.com/app/apikey
AI_API_KEY=

# Gemini model to use. Default: gemini-2.0-flash
# The working model confirmed during development: gemini-3.1-flash-lite
AI_MODEL=gemini-2.0-flash

# ── Frontend ──────────────────────────────────────────────────────────────────
# The URL the *browser* uses to reach the backend.
# When running with docker-compose and default ports, this is http://localhost:8000.
# Change this if you expose the backend on a different host/port.
VITE_API_BASE_URL=http://localhost:8000
